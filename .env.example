# Is file ko copy karke ".env" naam do aur apni keys bharo.
# (.env GitHub pe upload nahi hoti - .gitignore mein hai)

# Gemini (main brain) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Groq (backup brain + screen vision) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq fallback list (429/error pe agla; har model ka alag cooldown). Live list se check (2026-09-30)
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# low / medium / high - low sabse fast
GROQ_REASONING_EFFORT=low

# ElevenLabs (JARVIS ki awaaz) - khaali chhodo to free edge-tts awaaz chalegi
ELEVENLABS_API_KEY=
# George (deep British male) - dusri awaaz chahiye to uski Voice ID daalo
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Model: eleven_flash_v2_5 (tez + sasta, default) | eleven_multilingual_v2 (sunaawat khoobsurat)
# | eleven_turbo_v2_5 | eleven_v3
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Barge-in (bolte waqt "stop" bolke rok sakte ho) ---
# 1 = chalu, 0 = band. Sirf bolte hi chalta hai (CPU ~0 baaki waqt)
BARGE_IN=1
# Rokne wale shabd (comma se alag). NOTE: Vosk shabd nahi, AWAAZ pehchanta hai - isliye
# Hinglish "ruk jao" / "chup" bhi in shabdon jaisi sunaayi dekar rok dete hain (test: 39/39)
BARGE_IN_WORDS=stop, wait, enough, skip, hold on
# Mic ka darwaza: playback ke dauran jo sunaayi de raha hai wo JARVIS ki goonj hai,
# uska level x ye. Laptop speaker pe goonj badi hoti hai to darwaza upar chala jaata
# hai (galti se nahi rukega). TWS/earphone pe goonj nahi - darwaza normal rehta hai.
# Kamzor karo: 1.3 (aasan trigger), mazboot karo: 2.5 (sab se safe)
BARGE_IN_GATE_MULT=1.6
# Lagatar kitne 80ms tukde darwaze se upar aaye tabhi suno (4 = 0.32s) - door ke dhat nahi rukenge
BARGE_IN_LATCH_BLOCKS=4
# Awaaz tez aayi to confirm: itne ms aur audio suno, phir FinalResult (kam = tez, par miss ka chance)
BARGE_IN_CONFIRM_MS=400
# Bolna shuru hote hi pehle 0.4s sunna band (goonj banti hai) + bolna khatam hone ke
# baad 0.3s tak mic khula par trigger band (goonj utar rahi hai)
BARGE_IN_WARMUP_MS=400
BARGE_IN_ECHO_GUARD_MS=300

# 1 = test mode: shutdown/restart/lock/close_app sirf print honge, asli nahi chalenge
# 0 = normal use
DRY_RUN=0

# Gemini models (comma se alag, pehla = pasandida). 503/429 dene wala model kuch der skip hota hai
GEMINI_MODEL=gemini-3.6-flash,gemini-3.7-flash,gemini-flash-latest

# --- Sunna (STT) ---
# Engines ka order (pehla = default): google, groq (Whisper), gemini (transcribe). Vocabulary: vocab.txt
STT_ORDER=google,groq,gemini
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_STT_MODEL=gemini-3.5-transcribe
# Roz ki call limit (0 = koi nahi) aur per-minute limit. Limit ya error pe agla engine chalta hai
STT_GROQ_DAILY_LIMIT=1500
STT_GEMINI_DAILY_LIMIT=100
STT_GROQ_RPM=18
STT_GEMINI_RPM=4

# --- Wake word (openWakeWord "hey_jarvis") ---
# 0..1: zyada = TV/baat-cheet pe galat jaagna kam, par kabhi "Hey Jarvis" miss ho sakta hai. 0.4 = Indian awaaz bhi pakadta hai
WAKE_THRESHOLD=0.4
# Lagatar kitne 80ms-frames threshold ke upar hone chahiye (zyada = kam galat wake)
WAKE_PATIENCE=2
# 1 = detectors hamesha chalein (zyada CPU). 0 = sirf awaaz aane par (default)
WAKE_ALWAYS_ON=0
# 0 = openWakeWord band, sirf Vosk
WAKE_OPENWAKEWORD=1

# --- Dev helper (git_status / git_log, sirf padhna) ---
# JARVIS folder hamesha allowed hai. Aur project folders (comma se alag), jaise: D:\Projects\app1, D:\Projects\app2
DEV_PROJECT_DIRS=

# --- Translator mode (edge-tts free awaaz, target language ki; ElevenLabs credits nahi lagte) ---
TRANSLATE_VOICE_EN=en-GB-RyanNeural
TRANSLATE_VOICE_HI=hi-IN-MadhurNeural

# --- Sirf meri awaaz (speaker verification, sherpa-onnx, offline) ---
# Profile nahi bani to apne aap band. Profile: "Jarvis meri awaaz yaad karo" (ya HUD ka Voice button)
# Calibrate: python speaker.py --calibrate
SPEAKER_VERIFY=1
SPEAKER_THRESHOLD=0.45
SPEAKER_THRESHOLD_FOLLOWUP=0.35
# Models (models/speaker/ mein, official sherpa-onnx releases se; naam live list se dekhke)
SPEAKER_MODEL=wespeaker_en_voxceleb_CAM++_LM.onnx
VAD_MODEL=silero_vad.onnx
DENOISE_MODEL=gtcrn_simple.onnx
# 1 = har check se pehle denoise (+~400 ms; default 0: sirf borderline reject pe denoise ke saath dobara check)
SPEAKER_DENOISE=0
# 1 = STT ko bhi denoised audio do (abhi test nahi hua, default 0)
DENOISE_STT=0

# --- Agent (multi-step goal): hard limits ---
AGENT_MAX_STEPS=8
AGENT_MAX_SECONDS=90
AGENT_MAX_ERRORS=3

# --- Morning briefing (khali BRIEFING_TIME = band; khali BRIEFING_CITY = mausam nahi) ---
BRIEFING_TIME=07:30
BRIEFING_CITY=

# --- Telegram bot (1 = chalu; token @BotFather se, apna user ID @userinfobot se; comma se kai ID) ---
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Android phone control (ADB, sirf ghar ka WiFi) ---
# python phone_pair.py chalao (ek baar). Wireless debugging ka IP:port yahan aata hai; ye port phone ka
# Wireless debugging off/on karne pe badal sakta hai. Sirf private IP (192.168.x.x / 10.x.x.x) chalta hai.
PHONE_ADB_ADDRESS=
# Phone ka unlock PIN (sirf 4-10 ka number; pattern/letter nahi). KHALI chhod do tab tak JARVIS phone
# unlock nahi kar sakta. Kabhi print/log/commit nahi hota (.env gitignore hai). Chat box mein type karke
# "phone pin <number>" bhi set kar sakte ho - usse ye line RAM + .env dono mein likh di jaati hai.
PHONE_UNLOCK_PIN=
